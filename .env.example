# 复制本文件为 .env，然后填写本机使用的模型服务凭据。

# 摘要生成和 Agent 对话必填。不要把真实 API Key 提交到仓库。
OPENAI_API_KEY=

# 阿里云百炼 ASR API Key。仅当 ASR 供应商选择 aliyun_bailian 时需要。
DASHSCOPE_API_KEY=

# 工作区“模型供应商”页面使用的模型服务配置。
OPENAI_PROVIDER=openai_compatible
OPENAI_BASE_URL=
OPENAI_MODEL=

# 可选：HuggingFace 模型下载镜像地址，国内网络环境可保留该默认值。
HF_ENDPOINT=https://hf-mirror.com
# 可选：B 站完整 Cookie 字符串（优先级最高）。playinfo 接口需要 SESSDATA 之外的多
# 个 cookie 联防（buvid3/4/fp、b_nut、bili_jct、_uuid、DedeUserID 等），只塞 SESSDATA
# 会被 WAF 412。在浏览器登录 B 站后从 DevTools 的 Network > 任意 bilibili.com 请求
# 的 Request Headers > cookie 字段复制整个值过来即可。
BILIBILI_COOKIE=

# 单 cookie 的兼容入口：仅在未设置 BILIBILI_COOKIE 时生效。
BILIBILI_SESSDATA=

# 可选：同一进程内同时下载的 B 站视频数，默认 1（最不易触发 HTTP 412 风控）；
# 追求批量速度可改到 2，但失败率会上升。重启后生效。
BILIBILI_DOWNLOAD_CONCURRENCY=1

# 可选：yt-dlp 访问 B 站使用的代理 URL。direct/none/off 表示显式直连；留空则不额外
# 指定代理（沿用 yt-dlp 默认的环境代理行为）。
BILIBILI_YTDLP_PROXY=

# 可选：通过应用内“获取 Cookie”完成登录后会自动写入。手工配置时填写完整 Cookie header。
YOUTUBE_COOKIE=
DOUYIN_COOKIE=
